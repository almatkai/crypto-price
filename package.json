{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "crypto-price",
  "title": "Crypto Price",
  "description": "Keep an eye on Bitcoin (BTC), Ethereum (ETH), and other cryptocurrency prices and more directly from your system menu bar",
  "icon": "assets/command-icon.png",
  "author": "almatkai",
  "contributors": [
    "zampa"
  ],
  "categories": [
    "Finance"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "menu-bar",
      "title": "Crypto Price",
      "description": "See cryptocurency prices and more",
      "mode": "menu-bar",
      "interval": "1m",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "currency",
      "title": "Currency",
      "description": "Currency to use for the price",
      "type": "dropdown",
      "required": false,
      "default": "USD",
      "data": [
        {
          "title": "🇺🇸 United States dollar",
          "value": "USD"
        },
        {
          "title": "🇪🇺 Euro",
          "value": "EUR"
        },
        {
          "title": "🇬🇧 Pound Sterling",
          "value": "GBP"
        },
        {
          "title": "🇯🇵 Japanese Yen",
          "value": "JPY"
        },
        {
          "title": "🇧🇷 Brazilian Real",
          "value": "BRL"
        }
      ]
    },
    {
      "name": "style",
      "title": "Style",
      "description": "Style to display on the system menubar",
      "type": "dropdown",
      "required": false,
      "default": "price",
      "data": [
        {
          "title": "$1,234",
          "value": "price"
        },
        {
          "title": "100 $1,234 200",
          "value": "down24h-price-up24h"
        },
        {
          "title": "1% $1,234 2%",
          "value": "down24hPercent-price-up24hPercent"
        }
      ]
    },
    {
      "name": "source",
      "title": "Source",
      "description": "Preferred source for fetching the price. If it's unavailable, the extension automatically falls back to the other sources.",
      "type": "dropdown",
      "required": false,
      "default": "Binance",
      "data": [
        {
          "title": "Binance",
          "value": "Binance"
        },
        {
          "title": "CoinGecko",
          "value": "CoinGecko"
        },
        {
          "title": "OKX",
          "value": "OKX"
        },
        {
          "title": "Coinbase",
          "value": "Coinbase"
        },
        {
          "title": "Kraken",
          "value": "Kraken"
        },
        {
          "title": "CryptoCompare (needs API key)",
          "value": "CryptoCompare"
        }
      ]
    },
    {
      "title": "Coins",
      "name": "coins",
      "description": "Coins to enable, default is BTC | ETH BNB SOL XRP",
      "type": "textfield",
      "default": "BTC | ETH BNB SOL XRP",
      "required": false
    },
    {
      "name": "cryptoCompareApiKey",
      "title": "CryptoCompare API Key",
      "description": "Optional. A free CryptoCompare (CCData) API key. Only needed to use CryptoCompare as a source — its public API now requires a key.",
      "type": "password",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "id": "com.tezbar.crypto-price",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/crypto-price",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/crypto-price",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
